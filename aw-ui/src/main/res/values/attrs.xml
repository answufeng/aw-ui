<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AwStateLayout 自定义属性 -->
    <declare-styleable name="AwStateLayout">
        <attr name="loadingLayout" format="reference" />
        <attr name="emptyLayout" format="reference" />
        <attr name="errorLayout" format="reference" />
        <attr name="enableAnimation" format="boolean" />
        <attr name="animationDuration" format="integer" />
        <attr name="state_loadingStyle" format="enum">
            <enum name="spinner" value="0" />
            <enum name="skeleton" value="1" />
        </attr>
        <attr name="skeleton_maskColor" />
        <attr name="skeleton_shimmerColor" />
        <attr name="skeleton_maskCornerRadius" />
        <attr name="skeleton_shimmerDuration" />
        <attr name="skeleton_showShimmer" />
    </declare-styleable>


    <!-- AwBottomTabBar 自定义属性 -->
    <declare-styleable name="AwBottomTabBar">
        <attr name="tab_titles" format="reference" />
        <attr name="tab_icons" format="reference" />
        <attr name="tab_selected_color" format="color" />
        <attr name="tab_normal_color" format="color" />
        <attr name="tab_icon_size" format="dimension" />
        <attr name="tab_icon_height" format="dimension" />
        <attr name="tab_text_size" format="dimension" />
        <attr name="tab_icon_text_gap" format="dimension" />
        <attr name="tab_margin" format="dimension" />
        <attr name="tab_min_width" format="dimension" />
        <attr name="tab_mode" format="enum">
            <enum name="icon_text" value="0" />
            <enum name="icon_only" value="1" />
            <enum name="text_only" value="2" />
        </attr>
        <attr name="tab_layout_mode" format="enum">
            <enum name="fixed" value="0" />
            <enum name="scrollable" value="1" />
        </attr>
        <attr name="indicator_style" format="enum">
            <enum name="line" value="0" />
            <enum name="none" value="1" />
        </attr>
        <attr name="indicator_width_mode" format="enum">
            <enum name="match_tab" value="0" />
            <enum name="follow_text" value="1" />
        </attr>
        <attr name="indicator_color" format="color" />
        <attr name="indicator_height" format="dimension" />
        <attr name="indicator_marginTop" format="dimension" />
        <attr name="indicator_corner_radius" format="dimension" />
        <attr name="indicator_anim_duration" format="integer" />
        <attr name="tab_auto_tint" format="boolean" />
        <attr name="tab_selected_scale" format="float" />
        <attr name="tab_scale_duration" format="integer" />
        <attr name="badge_background_color" format="color" />
        <attr name="badge_text_color" format="color" />
        <attr name="badge_min_width" format="dimension" />
        <attr name="badge_padding" format="dimension" />
        <attr name="badge_text_size" format="dimension" />
        <attr name="enable_scroll_sync" format="boolean" />
        <attr name="background_color" format="color" />
        <attr name="enable_ripple" format="boolean" />
        <attr name="ripple_color" format="color" />
        <attr name="tabbar_elevation" format="dimension" />
        <attr name="corner_radius" format="dimension" />
    </declare-styleable>

    <!-- AwTitleBar 自定义属性 -->
    <declare-styleable name="AwTitleBar">
        <attr name="titleBar_title" format="string" />
        <attr name="titleBar_subtitle" format="string" />
        <attr name="titleBar_showBack" format="boolean" />
        <attr name="titleBar_leftIcon" format="reference" />
        <attr name="titleBar_rightText" format="string" />
        <attr name="titleBar_rightIcon" format="reference" />
        <attr name="titleBar_titleColor" format="color" />
        <attr name="titleBar_subtitleColor" format="color" />
        <attr name="titleBar_rightTextColor" format="color" />
        <attr name="titleBar_iconTint" format="color" />
        <attr name="titleBar_bgColor" format="color" />
        <attr name="titleBar_immersive" format="boolean" />
        <attr name="titleBar_showDivider" format="boolean" />
        <attr name="titleBar_dividerColor" format="color" />
        <attr name="titleBar_height" format="dimension" />
    </declare-styleable>

    <!-- AwBadgeView 自定义属性 -->
    <declare-styleable name="AwBadgeView">
        <attr name="badge_count" format="integer" />
        <attr name="badge_text" format="string" />
        <attr name="badge_bgColor" format="color" />
        <attr name="badge_textColor" format="color" />
        <attr name="badge_textSize" format="dimension" />
        <attr name="badge_dotSize" format="dimension" />
        <attr name="badge_minHeight" format="dimension" />
        <attr name="badge_horizontalPadding" format="dimension" />
    </declare-styleable>

    <!-- AwBannerView 自定义属性 -->
    <declare-styleable name="AwBannerView">
        <attr name="banner_interval" format="integer" />
        <attr name="banner_indicatorColor" format="color" />
        <attr name="banner_indicatorSelectedColor" format="color" />
        <attr name="banner_showIndicators" format="boolean" />
        <attr name="banner_autoStart" format="boolean" />
        <attr name="banner_infiniteLoop" format="boolean" />
        <attr name="banner_indicatorSize" format="dimension" />
        <attr name="banner_indicatorSpacing" format="dimension" />
        <attr name="banner_indicatorShape" format="enum">
            <enum name="circle" value="0" />
            <enum name="rect" value="1" />
        </attr>
        <attr name="banner_indicatorGravity" format="enum">
            <enum name="center" value="0" />
            <enum name="start" value="1" />
            <enum name="end" value="2" />
        </attr>
        <attr name="banner_indicatorMarginBottom" format="dimension" />
    </declare-styleable>

    <!-- AwCircleProgressBar 自定义属性 -->
    <declare-styleable name="AwCircleProgressBar">
        <attr name="circleProgress_progress" format="float" />
        <attr name="circleProgress_max" format="float" />
        <attr name="circleProgress_strokeWidth" format="dimension" />
        <attr name="circleProgress_progressColor" format="color" />
        <attr name="circleProgress_bgColor" format="color" />
        <attr name="circleProgress_showText" format="boolean" />
        <attr name="circleProgress_textColor" format="color" />
        <attr name="circleProgress_textSize" format="dimension" />
        <attr name="circleProgress_startAngle" format="float" />
        <attr name="circleProgress_suffix" format="string" />
    </declare-styleable>

    <!-- AwLoadingView 自定义属性 -->
    <declare-styleable name="AwLoadingView">
        <attr name="loading_style" format="enum">
            <enum name="circular" value="0" />
            <enum name="dots" value="1" />
            <enum name="horizontal" value="2" />
            <enum name="flower" value="3" />
            <enum name="bars" value="4" />
        </attr>
        <attr name="loading_tint" format="color" />
        <attr name="loading_size" format="dimension" />
    </declare-styleable>




    <!-- AwFlowLayout 自定义属性 -->
    <declare-styleable name="AwFlowLayout">
        <attr name="flow_horizontalSpacing" format="dimension" />
        <attr name="flow_verticalSpacing" format="dimension" />
        <attr name="flow_maxLines" format="integer" />
        <attr name="flow_gravity" format="enum">
            <enum name="start" value="0" />
            <enum name="center" value="1" />
            <enum name="end" value="2" />
        </attr>
    </declare-styleable>

    <!-- AwRoundLayout 自定义属性 -->
    <declare-styleable name="AwRoundLayout">
        <attr name="round_radius" format="dimension" />
        <attr name="round_topLeftRadius" format="dimension" />
        <attr name="round_topRightRadius" format="dimension" />
        <attr name="round_bottomLeftRadius" format="dimension" />
        <attr name="round_bottomRightRadius" format="dimension" />
        <attr name="round_strokeColor" format="color" />
        <attr name="round_strokeWidth" format="dimension" />
    </declare-styleable>

    <!-- AwCodeInputView 自定义属性 -->
    <declare-styleable name="AwCodeInputView">
        <attr name="code_length" format="integer" />
        <attr name="code_boxSize" format="dimension" />
        <attr name="code_boxSpacing" format="dimension" />
        <attr name="code_boxStrokeColor" format="color" />
        <attr name="code_boxStrokeWidth" format="dimension" />
        <attr name="code_textColor" format="color" />
        <attr name="code_textSize" format="dimension" />
    </declare-styleable>

    <!-- AwSegmentedControl 自定义属性 -->
    <declare-styleable name="AwSegmentedControl">
        <attr name="seg_items" format="reference" />
        <attr name="seg_selectedIndex" format="integer" />
        <attr name="seg_selectedColor" format="color" />
        <attr name="seg_textColor" format="color" />
        <attr name="seg_selectedTextColor" format="color" />
        <attr name="seg_selectionAppearance" format="enum">
            <enum name="pill" value="0" />
            <enum name="underline" value="1" />
            <enum name="text_tint" value="2" />
            <enum name="rect" value="3" />
        </attr>
        <!-- 仅 selectionAppearance=rect 时：选中块圆角。默认 4dp。设为 0dp 为直角长方形。 -->
        <attr name="seg_rectCornerRadius" format="dimension" />
        <attr name="seg_accessoryIndicator" format="enum">
            <enum name="none" value="0" />
            <enum name="dot" value="1" />
        </attr>
        <attr name="seg_iconSize" format="dimension" />
    </declare-styleable>

    <!-- AwExpandableLayout 自定义属性 -->
    <declare-styleable name="AwExpandableLayout">
        <attr name="expandable_expanded" format="boolean" />
        <attr name="expandable_duration" format="integer" />
    </declare-styleable>

    <!-- AwMarqueeTextView 自定义属性 -->
    <declare-styleable name="AwMarqueeTextView">
        <attr name="marquee_speed" format="float" />
        <attr name="marquee_pauseDuration" format="integer" />
        <attr name="marquee_direction" format="enum">
            <enum name="left_to_right" value="0" />
            <enum name="right_to_left" value="1" />
        </attr>
    </declare-styleable>

    <!-- AwSwitchButton 自定义属性 -->
    <declare-styleable name="AwSwitchButton">
        <attr name="switch_checked" format="boolean" />
        <attr name="switch_trackColor" format="color" />
        <attr name="switch_trackCheckedColor" format="color" />
        <attr name="switch_thumbColor" format="color" />
        <attr name="switch_thumbCheckedColor" format="color" />
        <attr name="switch_thumbShadowEnabled" format="boolean" />
    </declare-styleable>

    <!-- AwCountDownView 自定义属性 -->
    <declare-styleable name="AwCountDownView">
        <attr name="countdown_seconds" format="integer" />
        <attr name="countDownStrokeColor" format="color" />
        <attr name="countDownProgressColor" format="color" />
        <attr name="countDownTrackColor" format="color" />
        <attr name="countDownTextColor" format="color" />
        <attr name="countDownStrokeWidth" format="dimension" />
        <attr name="countDownTextSize" format="dimension" />
        <attr name="countDown_finishText" format="string" />
        <attr name="countDown_suffixText" format="string" />
        <attr name="countDown_initialText" format="string" />
        <attr name="countDown_runningTextFormat" format="string" />
        <attr name="countDown_displayMode" format="enum">
            <enum name="circle" value="0" />
            <enum name="text" value="1" />
        </attr>
        <attr name="countDown_timeMode" format="enum">
            <enum name="seconds" value="0" />
            <enum name="mmss" value="1" />
        </attr>
        <attr name="countDown_autoStartOnClick" format="boolean" />
        <attr name="countDown_disabledTextColor" format="color" />
        <attr name="countDown_textBorderColor" format="color" />
        <attr name="countDown_textBorderWidth" format="dimension" />
        <attr name="countDown_textBgColor" format="color" />
        <attr name="countDown_textCornerRadius" format="dimension" />
        <attr name="countDown_textPaddingH" format="dimension" />
        <attr name="countDown_textPaddingV" format="dimension" />
    </declare-styleable>

    <!-- AwSkeletonView 自定义属性 -->
    <declare-styleable name="AwSkeletonView">
        <attr name="skeleton_baseColor" format="color" />
        <attr name="skeleton_highlightColor" format="color" />
        <attr name="skeleton_cornerRadius" format="dimension" />
        <attr name="skeleton_duration" format="integer" />
    </declare-styleable>

    <!-- AwSkeletonLayout 自定义属性 -->
    <declare-styleable name="AwSkeletonLayout">
        <attr name="skeleton_maskColor" format="color" />
        <attr name="skeleton_shimmerColor" format="color" />
        <attr name="skeleton_maskCornerRadius" format="dimension" />
        <attr name="skeleton_shimmerDuration" format="integer" />
        <attr name="skeleton_showShimmer" format="boolean" />
        <attr name="skeleton_autoShow" format="boolean" />
    </declare-styleable>

    <attr name="skeleton_mask" format="boolean" />
    <attr name="skeleton_ignore" format="boolean" />

    <!-- AwRoundImageView 自定义属性 -->
    <declare-styleable name="AwRoundImageView">
        <attr name="roundImg_radius" format="dimension" />
        <attr name="roundImg_isCircle" format="boolean" />
        <attr name="roundImg_borderWidth" format="dimension" />
        <attr name="roundImg_borderColor" format="color" />
    </declare-styleable>

    <!-- AwSearchView 自定义属性 -->
    <declare-styleable name="AwSearchView">
        <attr name="search_hint" format="string" />
        <attr name="search_bgColor" format="color" />
        <attr name="search_iconColor" format="color" />
        <attr name="search_textColor" format="color" />
        <attr name="search_hintTextColor" format="color" />
        <attr name="search_searchIcon" format="reference" />
        <attr name="search_clearIcon" format="reference" />
        <attr name="search_cornerRadius" format="dimension" />
        <attr name="search_height" format="dimension" />
    </declare-styleable>

    <!-- AwSwipeRefreshLayout 自定义属性 -->
    <declare-styleable name="AwSwipeRefreshLayout">
        <attr name="refreshStyle" format="enum">
            <enum name="system" value="0" />
            <enum name="flower" value="1" />
            <enum name="arrow" value="2" />
            <enum name="text" value="3" />
        </attr>
        <attr name="refreshTintColor" format="color" />
        <attr name="refreshText" format="string" />
        <attr name="refreshTextColor" format="color" />
        <attr name="refreshTextSize" format="dimension" />
        <attr name="customRefreshHeaderLayout" format="reference" />
    </declare-styleable>

    <!-- AwTagView 自定义属性 -->
    <declare-styleable name="AwTagView">
        <attr name="tag_textColor" format="color" />
        <attr name="tag_selectedTextColor" format="color" />
        <attr name="tag_bgColor" format="color" />
        <attr name="tag_selectedBgColor" format="color" />
        <attr name="tag_textSize" format="dimension" />
        <attr name="tag_paddingH" format="dimension" />
        <attr name="tag_paddingV" format="dimension" />
        <attr name="tag_cornerRadius" format="dimension" />
        <attr name="tag_selectionMode" format="enum">
            <enum name="none" value="0" />
            <enum name="single" value="1" />
            <enum name="multi" value="2" />
        </attr>
        <attr name="tag_maxSelectCount" format="integer" />
    </declare-styleable>

    <declare-styleable name="AwStepView">
        <attr name="step_count" format="integer" />
        <attr name="step_current" format="integer" />
        <attr name="step_activeColor" format="color" />
        <attr name="step_inactiveColor" format="color" />
    </declare-styleable>

    <declare-styleable name="AwRatingBar">
        <attr name="rating_maxStars" format="integer" />
        <attr name="rating_value" format="float" />
        <attr name="rating_starSize" format="dimension" />
        <attr name="rating_starSpacing" format="dimension" />
        <attr name="rating_filledColor" format="color" />
        <attr name="rating_emptyColor" format="color" />
        <attr name="rating_isIndicator" format="boolean" />
        <attr name="rating_stepSize" format="float" />
    </declare-styleable>

    <declare-styleable name="AwNoticeBar">
        <attr name="notice_text" format="string" />
        <attr name="notice_closable" format="boolean" />
        <attr name="notice_backgroundColor" format="color" />
    </declare-styleable>

    <declare-styleable name="AwIndexBar">
        <attr name="index_textColor" format="color" />
        <attr name="index_selectedTextColor" format="color" />
        <attr name="index_textSize" format="dimension" />
    </declare-styleable>

</resources>
