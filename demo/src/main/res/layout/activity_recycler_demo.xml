<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.answufeng.ui.widget.AwTitleBar
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleBar_showBack="true"
        app:titleBar_showDivider="true"
        app:titleBar_title="RecyclerView 工具集" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.AwUi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.AwUi.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="AwSimpleAdapter" />

                    <TextView
                        style="@style/Text.AwUi.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:text="ListAdapter + DiffUtil + ViewBinding，支持点击与空视图" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvSimple"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:nestedScrollingEnabled="false" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSimpleAdd"
                            style="@style/MaterialButton.AwUi"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/recycler_demo_add" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSimpleRemove"
                            style="@style/MaterialButton.AwUi.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/recycler_demo_remove" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.AwUi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.AwUi.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="AwMultiTypeAdapter" />

                    <TextView
                        style="@style/Text.AwUi.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:text="DSL 注册多种 item 类型，配合 AwItemAnimator 展示增删动画" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvMultiType"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:nestedScrollingEnabled="false" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleMultiType"
                        style="@style/MaterialButton.AwUi.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/recycler_demo_toggle_type" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.AwUi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.AwUi.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="AwDividerDecoration" />

                    <TextView
                        style="@style/Text.AwUi.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:text="带左右缩进的分割线，最后一项不绘制" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvDivider"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
