<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.answufeng.ui.widget.AwTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleBar_immersive="true"
        app:titleBar_showBack="true"
        app:titleBar_title="@string/seg_demo_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.AwUi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.AwUi.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/seg_demo_sec_text_pill" />

                    <com.answufeng.ui.widget.AwSegmentedControl
                        android:id="@+id/segTextPill"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        app:seg_items="@array/segment_items"
                        app:seg_accessoryIndicator="none"
                        app:seg_selectionAppearance="pill" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.AwUi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.AwUi.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/seg_demo_sec_text_rect" />

                    <com.answufeng.ui.widget.AwSegmentedControl
                        android:id="@+id/segTextRect"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        app:seg_accessoryIndicator="none"
                        app:seg_items="@array/segment_items"
                        app:seg_rectCornerRadius="4dp"
                        app:seg_selectionAppearance="rect" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.AwUi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.AwUi.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/seg_demo_sec_text_underline" />

                    <com.answufeng.ui.widget.AwSegmentedControl
                        android:id="@+id/segTextUnderline"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        app:seg_accessoryIndicator="none"
                        app:seg_items="@array/segment_items"
                        app:seg_selectionAppearance="underline" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.AwUi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.AwUi.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/seg_demo_sec_text_tint" />

                    <com.answufeng.ui.widget.AwSegmentedControl
                        android:id="@+id/segTextTint"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        app:seg_accessoryIndicator="none"
                        app:seg_items="@array/segment_items"
                        app:seg_selectionAppearance="text_tint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.AwUi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.AwUi.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/seg_demo_sec_text_tint_dot" />

                    <com.answufeng.ui.widget.AwSegmentedControl
                        android:id="@+id/segTextTintDot"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        app:seg_accessoryIndicator="dot"
                        app:seg_items="@array/segment_items"
                        app:seg_selectionAppearance="text_tint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.AwUi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.AwUi.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/seg_demo_sec_pill_dot" />

                    <com.answufeng.ui.widget.AwSegmentedControl
                        android:id="@+id/segPillWithDot"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        app:seg_accessoryIndicator="dot"
                        app:seg_items="@array/segment_items"
                        app:seg_selectionAppearance="pill" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.AwUi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.AwUi.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/seg_demo_sec_icon_text" />

                    <com.answufeng.ui.widget.AwSegmentedControl
                        android:id="@+id/segIconText"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        app:seg_accessoryIndicator="none"
                        app:seg_selectionAppearance="pill" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.AwUi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.AwUi.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/seg_demo_sec_icon_only" />

                    <com.answufeng.ui.widget.AwSegmentedControl
                        android:id="@+id/segIconOnly"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        app:seg_accessoryIndicator="none"
                        app:seg_selectionAppearance="pill" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.AwUi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.AwUi.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/seg_demo_sec_pager" />

                    <com.answufeng.ui.widget.AwSegmentedControl
                        android:id="@+id/segWithPager"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        app:seg_accessoryIndicator="none"
                        app:seg_items="@array/segment_items"
                        app:seg_selectionAppearance="underline" />

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/vpWithPager"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvPagerSyncHint"
                        style="@style/Text.AwUi.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/seg_demo_pager_bound_hint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.AwUi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.AwUi.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/seg_demo_sec_no_pager" />

                    <com.answufeng.ui.widget.AwSegmentedControl
                        android:id="@+id/segNoPager"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        app:seg_accessoryIndicator="dot"
                        app:seg_items="@array/segment_items"
                        app:seg_selectionAppearance="text_tint" />

                    <TextView
                        android:id="@+id/tvNoPagerState"
                        style="@style/Text.AwUi.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
