<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <com.answufeng.ui.widget.AwTitleBar
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleBar_showBack="true"
        app:titleBar_showDivider="true"
        app:titleBar_title="AwExpandableLayout" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="基础展开/收起"
                style="@style/Text.AwUi.Subtitle"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_toggle_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="展开/收起" />

            <com.answufeng.ui.widget.AwExpandableLayout
                android:id="@+id/expandable_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:expandable_expanded="false"
                app:expandable_duration="300">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/surface_variant"
                    android:padding="16dp"
                    android:text="这是可展开/收起的内容区域。点击上方的按钮可以切换展开状态，展开和收起都有平滑的高度动画效果。支持自定义动画时长。"
                    style="@style/Text.AwUi.Body" />
            </com.answufeng.ui.widget.AwExpandableLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="慢速动画（800ms）"
                style="@style/Text.AwUi.Subtitle"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_toggle_2"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="展开/收起（慢速）" />

            <com.answufeng.ui.widget.AwExpandableLayout
                android:id="@+id/expandable_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:expandable_expanded="false"
                app:expandable_duration="800">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/surface_variant"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="第一行内容"
                        style="@style/Text.AwUi.Body" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="第二行内容"
                        style="@style/Text.AwUi.Body" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="第三行内容"
                        style="@style/Text.AwUi.Body" />
                </LinearLayout>
            </com.answufeng.ui.widget.AwExpandableLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="默认展开"
                style="@style/Text.AwUi.Subtitle"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_toggle_3"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="收起/展开" />

            <com.answufeng.ui.widget.AwExpandableLayout
                android:id="@+id/expandable_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:expandable_expanded="true"
                app:expandable_duration="500">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/surface_variant"
                    android:padding="16dp"
                    android:text="这段内容默认是展开的。初始状态通过 expandable_expanded 属性控制。"
                    style="@style/Text.AwUi.Body" />
            </com.answufeng.ui.widget.AwExpandableLayout>

            <TextView
                android:id="@+id/tv_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minHeight="80dp"
                android:background="@color/surface_variant"
                android:padding="12dp"
                android:text="操作日志将显示在这里..."
                android:lineSpacingExtra="4dp"
                style="@style/Text.AwUi.Body" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
