<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <com.answufeng.ui.widget.AwTitleBar
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleBar_showBack="true"
        app:titleBar_showDivider="true"
        app:titleBar_title="AwCodeInputView" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="6位验证码（默认）"
                style="@style/Text.AwUi.Subtitle"
                android:layout_marginBottom="12dp" />

            <com.answufeng.ui.widget.AwCodeInputView
                android:id="@+id/code_input_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                app:code_length="6"
                app:code_boxSize="48dp"
                app:code_boxSpacing="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="4位验证码"
                style="@style/Text.AwUi.Subtitle"
                android:layout_marginBottom="12dp" />

            <com.answufeng.ui.widget.AwCodeInputView
                android:id="@+id/code_input_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                app:code_length="4"
                app:code_boxSize="56dp"
                app:code_boxSpacing="12dp"
                app:code_boxStrokeColor="#4F46E5"
                app:code_textColor="#4F46E5" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="自定义样式"
                style="@style/Text.AwUi.Subtitle"
                android:layout_marginBottom="12dp" />

            <com.answufeng.ui.widget.AwCodeInputView
                android:id="@+id/code_input_custom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                app:code_length="5"
                app:code_boxSize="52dp"
                app:code_boxSpacing="10dp"
                app:code_boxStrokeWidth="3dp"
                app:code_boxStrokeColor="#22C55E"
                app:code_textColor="#22C55E"
                app:code_textSize="20sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_fill_code"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="程序化填充验证码" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_code"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="清空验证码" />

            <TextView
                android:id="@+id/tv_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minHeight="80dp"
                android:background="@color/surface_variant"
                android:padding="12dp"
                android:text="操作日志将显示在这里..."
                android:lineSpacingExtra="4dp"
                style="@style/Text.AwUi.Body" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
