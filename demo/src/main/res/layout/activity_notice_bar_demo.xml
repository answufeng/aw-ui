<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.answufeng.ui.widget.AwTitleBar
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleBar_showBack="true"
        app:titleBar_showDivider="true"
        app:titleBar_title="AwNoticeBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.answufeng.ui.widget.AwNoticeBar
                android:id="@+id/noticeBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:notice_closable="true"
                app:notice_text="欢迎使用 aw-ui，点击通知条或下方按钮切换文案" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.AwUi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.AwUi.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="顶部通知条，适合活动提示、版本更新等场景。" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUpdateMessage"
                        style="@style/MaterialButton.AwUi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="切换通知文案" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShowNotice"
                        style="@style/MaterialButton.AwUi.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="显示通知" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
