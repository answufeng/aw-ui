<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <com.answufeng.ui.widget.AwTitleBar
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleBar_showBack="true"
        app:titleBar_showDivider="true"
        app:titleBar_title="AwSkeletonView" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="列表项骨架屏"
                style="@style/Text.AwUi.Subtitle"
                android:layout_marginBottom="12dp" />

            <com.answufeng.ui.widget.AwRoundLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:round_radius="12dp"
                app:round_strokeColor="#E0E0E0"
                app:round_strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.answufeng.ui.widget.AwSkeletonView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:skeleton_cornerRadius="24dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <com.answufeng.ui.widget.AwSkeletonView
                                android:layout_width="120dp"
                                android:layout_height="14dp"
                                android:layout_marginBottom="8dp"
                                app:skeleton_cornerRadius="4dp" />

                            <com.answufeng.ui.widget.AwSkeletonView
                                android:layout_width="80dp"
                                android:layout_height="12dp"
                                app:skeleton_cornerRadius="4dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.answufeng.ui.widget.AwSkeletonView
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="12dp"
                        app:skeleton_cornerRadius="4dp" />

                    <com.answufeng.ui.widget.AwSkeletonView
                        android:layout_width="200dp"
                        android:layout_height="12dp"
                        android:layout_marginTop="8dp"
                        app:skeleton_cornerRadius="4dp" />
                </LinearLayout>
            </com.answufeng.ui.widget.AwRoundLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="卡片骨架屏"
                style="@style/Text.AwUi.Subtitle"
                android:layout_marginBottom="12dp" />

            <com.answufeng.ui.widget.AwRoundLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:round_radius="12dp"
                app:round_strokeColor="#E0E0E0"
                app:round_strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.answufeng.ui.widget.AwSkeletonView
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginBottom="12dp"
                        app:skeleton_cornerRadius="8dp" />

                    <com.answufeng.ui.widget.AwSkeletonView
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:layout_marginBottom="8dp"
                        app:skeleton_cornerRadius="4dp" />

                    <com.answufeng.ui.widget.AwSkeletonView
                        android:layout_width="150dp"
                        android:layout_height="14dp"
                        app:skeleton_cornerRadius="4dp" />
                </LinearLayout>
            </com.answufeng.ui.widget.AwRoundLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="动画控制"
                style="@style/Text.AwUi.Subtitle"
                android:layout_marginBottom="12dp" />

            <com.answufeng.ui.widget.AwSkeletonView
                android:id="@+id/skeleton_controllable"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                app:skeleton_baseColor="#E0E0E0"
                app:skeleton_highlightColor="#F5F5F5"
                app:skeleton_cornerRadius="8dp"
                app:skeleton_duration="1500" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_toggle_skeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="开始/停止动画" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
