<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <com.answufeng.ui.widget.AwTitleBar
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleBar_showBack="true"
        app:titleBar_showDivider="true"
        app:titleBar_title="AwMarqueeTextView" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="从右到左（默认）"
                style="@style/Text.AwUi.Subtitle"
                android:layout_marginBottom="12dp" />

            <com.answufeng.ui.widget.AwMarqueeTextView
                android:id="@+id/marquee_rtl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="这是一条从右到左滚动的公告：重要通知，系统将于今晚22:00进行维护升级，届时服务将暂停。"
                android:textSize="14sp"
                android:textColor="@color/on_surface"
                app:marquee_speed="1"
                app:marquee_pauseDuration="2000"
                app:marquee_direction="right_to_left" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="从左到右"
                style="@style/Text.AwUi.Subtitle"
                android:layout_marginBottom="12dp" />

            <com.answufeng.ui.widget.AwMarqueeTextView
                android:id="@+id/marquee_ltr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="这是一条从左到右滚动的公告：新版本已发布，请及时更新以获得最佳体验。"
                android:textSize="14sp"
                android:textColor="@color/on_surface"
                app:marquee_speed="1.5"
                app:marquee_pauseDuration="1500"
                app:marquee_direction="left_to_right" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="快速滚动"
                style="@style/Text.AwUi.Subtitle"
                android:layout_marginBottom="12dp" />

            <com.answufeng.ui.widget.AwMarqueeTextView
                android:id="@+id/marquee_fast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="快速滚动示例：这条公告以3倍速度滚动，适用于需要快速传递信息的场景。"
                android:textSize="14sp"
                android:textColor="#FF6B6B"
                app:marquee_speed="3"
                app:marquee_pauseDuration="500"
                app:marquee_direction="right_to_left" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="动态更新文本"
                style="@style/Text.AwUi.Subtitle"
                android:layout_marginBottom="12dp" />

            <com.answufeng.ui.widget.AwMarqueeTextView
                android:id="@+id/marquee_dynamic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="初始文本内容"
                android:textSize="14sp"
                android:textColor="@color/on_surface"
                app:marquee_speed="1"
                app:marquee_direction="right_to_left" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_update_text"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="更新文本内容" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
