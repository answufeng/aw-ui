<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <com.answufeng.ui.widget.AwTitleBar
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleBar_showBack="true"
        app:titleBar_showDivider="true"
        app:titleBar_title="AwSearchView" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="默认样式"
                style="@style/Text.AwUi.Subtitle"
                android:layout_marginBottom="12dp" />

            <com.answufeng.ui.widget.AwSearchView
                android:id="@+id/search_default"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="自定义样式"
                style="@style/Text.AwUi.Subtitle"
                android:layout_marginBottom="12dp" />

            <com.answufeng.ui.widget.AwSearchView
                android:id="@+id/search_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:search_hint="输入关键词搜索..."
                app:search_bgColor="#E8F5E9"
                app:search_iconColor="#4CAF50"
                app:search_textColor="#2E7D32"
                app:search_hintTextColor="#81C784" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="深色背景"
                style="@style/Text.AwUi.Subtitle"
                android:layout_marginBottom="12dp" />

            <com.answufeng.ui.widget.AwSearchView
                android:id="@+id/search_dark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:search_hint="搜索内容..."
                app:search_bgColor="#37474F"
                app:search_iconColor="#B0BEC5"
                app:search_textColor="#ECEFF1"
                app:search_hintTextColor="#78909C" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="代码动态修改"
                style="@style/Text.AwUi.Subtitle"
                android:layout_marginBottom="12dp" />

            <com.answufeng.ui.widget.AwSearchView
                android:id="@+id/search_dynamic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_change_hint"
                    style="@style/MaterialButton.AwUi.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="换提示" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_change_color"
                    style="@style/MaterialButton.AwUi.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="换颜色" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="回调日志"
                style="@style/Text.AwUi.Subtitle"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                android:background="@color/surface_variant"
                android:padding="12dp"
                android:text="搜索回调将显示在这里..."
                android:lineSpacingExtra="4dp"
                style="@style/Text.AwUi.Body" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
