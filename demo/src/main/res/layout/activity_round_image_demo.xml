<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <com.answufeng.ui.widget.AwTitleBar
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleBar_showBack="true"
        app:titleBar_showDivider="true"
        app:titleBar_title="圆角与裁切" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.AwUi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.AwUi.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="AwRoundImageView · 圆形头像" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="horizontal">

                        <com.answufeng.ui.widget.AwRoundImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:src="@drawable/bg_sample_blue"
                            app:roundImg_isCircle="true"
                            app:roundImg_borderColor="#FFFFFF"
                            app:roundImg_borderWidth="2dp" />

                        <com.answufeng.ui.widget.AwRoundImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_marginStart="16dp"
                            android:src="@drawable/bg_sample_orange"
                            app:roundImg_isCircle="true"
                            app:roundImg_borderColor="#F97316"
                            app:roundImg_borderWidth="3dp" />

                        <com.answufeng.ui.widget.AwRoundImageView
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:layout_marginStart="16dp"
                            android:src="@drawable/bg_sample_green"
                            app:roundImg_isCircle="true" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.AwUi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.AwUi.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="AwRoundImageView · 圆角图片" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.answufeng.ui.widget.AwRoundImageView
                            android:layout_width="0dp"
                            android:layout_height="90dp"
                            android:layout_weight="1"
                            android:src="@drawable/bg_sample_pink"
                            app:roundImg_radius="8dp" />

                        <com.answufeng.ui.widget.AwRoundImageView
                            android:layout_width="0dp"
                            android:layout_height="90dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:src="@drawable/bg_sample_blue"
                            app:roundImg_radius="16dp" />

                        <com.answufeng.ui.widget.AwRoundImageView
                            android:layout_width="0dp"
                            android:layout_height="90dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:src="@drawable/bg_sample_green"
                            app:roundImg_borderColor="#10B981"
                            app:roundImg_borderWidth="2dp"
                            app:roundImg_radius="24dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.AwUi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.AwUi.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="AwRoundImageView · 动态切换" />

                    <com.answufeng.ui.widget.AwRoundImageView
                        android:id="@+id/round_image_dynamic"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center_horizontal"
                        android:src="@drawable/bg_sample_orange"
                        app:roundImg_radius="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_toggle_circle"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="圆形/圆角" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_change_radius"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="增大圆角" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_change_border"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="切换边框" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.AwUi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.AwUi.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="AwRoundLayout · 统一圆角" />

                    <com.answufeng.ui.widget.AwRoundLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:round_radius="16dp"
                        app:round_strokeColor="#E0E0E0"
                        app:round_strokeWidth="1dp">

                        <TextView
                            style="@style/Text.AwUi.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#FFFFFF"
                            android:padding="16dp"
                            android:text="四角统一 16dp 圆角，带 1dp 描边" />
                    </com.answufeng.ui.widget.AwRoundLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.AwUi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.AwUi.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="AwRoundLayout · 独立圆角" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.answufeng.ui.widget.AwRoundLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:round_bottomLeftRadius="0dp"
                            app:round_bottomRightRadius="0dp"
                            app:round_topLeftRadius="24dp"
                            app:round_topRightRadius="24dp">

                            <TextView
                                style="@style/Text.AwUi.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="#3B82F6"
                                android:padding="16dp"
                                android:text="仅顶部圆角 24dp"
                                android:textColor="#FFFFFF" />
                        </com.answufeng.ui.widget.AwRoundLayout>

                        <com.answufeng.ui.widget.AwRoundLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            app:round_bottomLeftRadius="0dp"
                            app:round_bottomRightRadius="24dp"
                            app:round_topLeftRadius="24dp"
                            app:round_topRightRadius="0dp">

                            <TextView
                                style="@style/Text.AwUi.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="#10B981"
                                android:padding="16dp"
                                android:text="左上+右下圆角 24dp"
                                android:textColor="#FFFFFF" />
                        </com.answufeng.ui.widget.AwRoundLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.AwUi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.AwUi.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="AwRoundLayout · 图片裁切" />

                    <com.answufeng.ui.widget.AwRoundLayout
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        app:round_radius="16dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/bg_sample_pink" />
                    </com.answufeng.ui.widget.AwRoundLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
