<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <com.answufeng.ui.widget.AwTitleBar
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleBar_showDivider="true"
        app:titleBar_title="AwLoadingView Demo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <com.answufeng.ui.widget.AwLoadingView
            android:id="@+id/demo_loading"
            android:layout_width="160dp"
            android:layout_height="72dp"
            app:loading_size="48dp"
            app:loading_style="circular"
            app:loading_tint="#FF6B3D" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_switch_style"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="切换样式" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_animation"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="开始 / 停止动画" />
    </LinearLayout>

</LinearLayout>
