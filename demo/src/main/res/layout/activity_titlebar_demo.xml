<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <com.answufeng.ui.widget.AwTitleBar
        android:id="@+id/demo_titlebar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleBar_bgColor="@color/white"
        app:titleBar_iconTint="@color/text_primary"
        app:titleBar_showDivider="true"
        app:titleBar_title="订单中心" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="演示点：副标题显隐、右侧文字/图标切换、标题栏高度变化。"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="切换副标题" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_action"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="切换右侧动作" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_height"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="切换标题栏高度" />
    </LinearLayout>

</LinearLayout>
